{
  "name": "developer-profile-api",
  "version": "1.0.0",
  "description": "Digital business card API built with NestJS, Apollo GraphQL, Prisma and PostgreSQL",
  "main": "dist/src/main.js",
  "scripts": {
    "build": "prisma generate && tsc -p tsconfig.json",
    "predev": "prisma generate",
    "dev": "tsc-watch --onSuccess \"npm run start:prod\"",
    "start": "npm run build && npm run start:prod",
    "start:prod": "npm run db:prepare && node dist/src/main.js",
    "db:prepare": "prisma migrate deploy && prisma db seed",
    "db:up": "docker compose up -d --wait postgres",
    "db:down": "docker compose down",
    "db:migrate": "prisma migrate dev",
    "db:seed": "npm run build && prisma db seed",
    "db:studio": "prisma studio",
    "test": "npm run build && node --test test/*.test.mjs",
    "build:vercel": "npm run build && npm run db:prepare"
  },
  "keywords": [],
  "author": "Данила Деренченко",
  "license": "ISC",
  "type": "module",
  "devDependencies": {
    "@types/node": "^26.6.3",
    "@types/pg": "^8.23.1",
    "tsc-watch": "^7.2.1",
    "typescript": "^5.9.3"
  },
  "dependencies": {
    "@apollo/server": "^5.5.1",
    "@as-integrations/express5": "^1.1.2",
    "@nestjs/apollo": "^14.0.3",
    "@nestjs/common": "^12.1.3",
    "@nestjs/core": "^12.1.3",
    "@nestjs/graphql": "^14.0.3",
    "@nestjs/platform-express": "^12.1.3",
    "@prisma/adapter-pg": "^7.10.0",
    "@prisma/client": "^7.10.0",
    "@vercel/functions": "^3.9.11",
    "dotenv": "^18.0.4",
    "graphql": "^16.14.2",
    "pg": "^8.23.0",
    "prisma": "^7.10.0",
    "reflect-metadata": "^0.2.2",
    "rxjs": "^7.8.2"
  },
  "engines": {
    "node": "24.x"
  },
  "overrides": {
    "@prisma/config": {
      "deepmerge-ts": "8.0.2"
    },
    "prisma": {
      "mysql2": "3.24.5"
    }
  }
}
